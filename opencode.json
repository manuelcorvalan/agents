{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "jira": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@nexus2520/jira-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "JIRA_EMAIL": "{env:JIRA_EMAIL}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
        "JIRA_BASE_URL": "{env:JIRA_BASE_URL}"
      }
    }
  },
  "agent": {
    "pm": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "backend": {
      "permission": {
        "codegraph_*": "allow"
      }
    },
    "frontend": {
      "permission": {
        "codegraph_*": "allow"
      }
    },
    "qa": {
      "permission": {
        "codegraph_*": "allow"
      }
    },
    "architect": {
      "permission": {
        "codegraph_*": "allow"
      }
    },
    "po": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "database": {
      "permission": {
        "codegraph_*": "allow"
      }
    },
    "data-analyst": {
      "permission": {
        "codegraph_*": "allow"
      }
    },
    "devops": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "web-design": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "business": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "security": {
      "permission": {
        "codegraph_*": "allow"
      }
    },
    "tech-writer": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "release-manager": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "reporting": {
      "permission": {
        "codegraph_*": "deny",
        "jira_*": "allow"
      }
    }
  }
}
