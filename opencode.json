{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "jira": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@nexus2520/jira-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "JIRA_EMAIL": "${JIRA_EMAIL}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
        "JIRA_BASE_URL": "${JIRA_BASE_URL}"
      }
    }
  },
  "agent": {
    "pm": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "backend": {
      "permission": {
        "codegraph_*": "allow"
      }
    },
    "frontend": {
      "permission": {
        "codegraph_*": "allow"
      }
    },
    "qa": {
      "permission": {
        "codegraph_*": "allow"
      }
    },
    "po": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "database": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "data-analyst": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "devops": {
      "permission": {
        "codegraph_*": "deny"
      }
    },
    "web-design": {
      "permission": {
        "codegraph_*": "deny"
      }
    }
  }
}
