#!/usr/bin/env bash
# =============================================================================
# factory-init — scaffold a project for the opencode-agents software factory
# =============================================================================
# Usage:
#   factory-init <project-path> [--dry-run]
#
# What it does:
#   1. Symlinks this factory's agents/   -> ~/.config/opencode/agents
#      and                      commands/ -> ~/.config/opencode/commands
#      so OpenCode detects the team globally (see README § "Instalación").
#   2. Copies .env.example -> <project>/.env  (only if .env does NOT exist).
#   3. Copies templates/    -> <project>/templates/  (PRD, etc.).
#   4. Runs `codegraph init` inside the project if the codegraph CLI exists.
#
# Claude Code alternative (NOT symlinked into ~/.config):
#   ln -s <factory-root>/.claude  <project>/.claude
#   # .claude/ MUST live INSIDE the project working directory for Claude Code
#   # to detect it. agents/ are referenced by .claude/CLAUDE.md — not duplicated.
#   # Example:  ln -s ~/opencode-agents/.claude ~/mi-proyecto/.claude
#
# Safety: non-destructive. Never overwrites an existing .env. Backs up
# non-symlink targets before replacing. `--dry-run` prints actions only.
# =============================================================================

set -euo pipefail

# --- Locate factory root (parent of bin/) ------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FACTORY_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# --- Config (override via env) -----------------------------------------------
OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
DRY_RUN=0

usage() {
  cat <<'EOF'
Usage: factory-init <project-path> [--dry-run]

Scaffold <project-path> to use the opencode-agents software factory.

  <project-path>   Target project directory (created if missing).
  --dry-run        Print actions without executing them.

Examples:
  factory-init ~/code/my-app
  factory-init ~/code/my-app --dry-run
EOF
}

log()  { printf '\033[1;32m[factory-init]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[factory-init]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[factory-init]\033[0m %s\n' "$*" >&2; exit 1; }

# --- Args --------------------------------------------------------------------
[[ $# -lt 1 ]] && { usage; exit 1; }
PROJECT=""
for a in "$@"; do
  case "$a" in
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) usage; exit 1 ;;
    *) [[ -n "$PROJECT" ]] && { usage; exit 1; }; PROJECT="$a" ;;
  esac
done
[[ -z "$PROJECT" ]] && { usage; exit 1; }

# --- Normalize project path to absolute --------------------------------------
PROJECT="${PROJECT%/}"
[[ "$PROJECT" == "." ]] && PROJECT="$PWD"
if [[ "$PROJECT" != /* ]]; then
  PROJECT="$PWD/$PROJECT"
fi
PARENT="$(dirname "$PROJECT")"
BASE="$(basename "$PROJECT")"
RESOLVED_PARENT="$(cd "$PARENT" 2>/dev/null && pwd)"
PROJECT="${RESOLVED_PARENT:-$PARENT}/$BASE"

# --- Sanity: factory must have the required dirs/files -----------------------
[[ -d "$FACTORY_ROOT/agents"     ]] || err "Missing $FACTORY_ROOT/agents"
[[ -d "$FACTORY_ROOT/commands"   ]] || err "Missing $FACTORY_ROOT/commands"
[[ -d "$FACTORY_ROOT/templates"  ]] || err "Missing $FACTORY_ROOT/templates"
[[ -f "$FACTORY_ROOT/.env.example" ]] || err "Missing $FACTORY_ROOT/.env.example"

# --- Helpers -----------------------------------------------------------------
symlink() { # $1=source(abs) $2=dest(abs)
  local src="$1" dst="$2"
  if [[ -L "$dst" ]]; then
    log "refresh symlink: $dst -> $src"
    [[ $DRY_RUN -eq 0 ]] && ln -sfn "$src" "$dst"
  elif [[ -e "$dst" ]]; then
    local bak="${dst}.bak.$(date +%s)"
    warn "backup existing non-symlink: $dst -> $bak"
    [[ $DRY_RUN -eq 0 ]] && mv "$dst" "$bak"
    log "create symlink: $dst -> $src"
    [[ $DRY_RUN -eq 0 ]] && ln -s "$src" "$dst"
  else
    log "create symlink: $dst -> $src"
    [[ $DRY_RUN -eq 0 ]] && ln -s "$src" "$dst"
  fi
}

copy_if_missing() { # $1=src $2=dst
  local src="$1" dst="$2"
  if [[ -e "$dst" ]]; then
    log "skip (exists): $dst"
  else
    log "copy: $src -> $dst"
    [[ $DRY_RUN -eq 0 ]] && cp "$src" "$dst"
  fi
}

# --- Main --------------------------------------------------------------------
log "factory root : $FACTORY_ROOT"
log "project      : $PROJECT"
log "opencode cfg : $OPENCODE_CONFIG_DIR"

# 1. OpenCode global symlinks (agents + commands)
log "== OpenCode symlinks =="
[[ $DRY_RUN -eq 0 ]] && mkdir -p "$OPENCODE_CONFIG_DIR"
symlink "$FACTORY_ROOT/agents"   "$OPENCODE_CONFIG_DIR/agents"
symlink "$FACTORY_ROOT/commands" "$OPENCODE_CONFIG_DIR/commands"

# 2. Ensure project dir exists
log "== Project scaffold =="
[[ $DRY_RUN -eq 0 ]] && mkdir -p "$PROJECT"

# 3. .env (never overwrite an existing one)
copy_if_missing "$FACTORY_ROOT/.env.example" "$PROJECT/.env"

# 4. templates/ -> project
if [[ -e "$PROJECT/templates" ]]; then
  log "skip (exists): $PROJECT/templates"
else
  log "copy: $FACTORY_ROOT/templates -> $PROJECT/templates"
  [[ $DRY_RUN -eq 0 ]] && cp -R "$FACTORY_ROOT/templates" "$PROJECT/templates"
fi

# 5. codegraph init (project) — only if CLI present
log "== CodeGraph index =="
if command -v codegraph >/dev/null 2>&1; then
  log "codegraph detected — indexing project"
  [[ $DRY_RUN -eq 0 ]] && (cd "$PROJECT" && codegraph init)
else
  warn "codegraph CLI not found — skipping (install: npm i -g @colbymchenry/codegraph)"
fi

# 6. Claude Code alternative (documented, not automated)
log "== Claude Code =="
cat <<EOF
  Claude Code does NOT use ~/.config symlinks. Wire the factory manually:
    ln -s "$FACTORY_ROOT/.claude" "$PROJECT/.claude"
  (.claude/ must live inside the project working directory to be detected.)
EOF

log "done."
