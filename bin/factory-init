#!/usr/bin/env bash
# =============================================================================
# factory-init — scaffold a project for the opencode-agents software factory
# =============================================================================
# Usage:
#   factory-init <project-path> [--dry-run] [--with-plugins]
#                [--with-ponytail] [--with-caveman] [--with-rtk] [--with-graphify]
#
# What it does:
#   1. Symlinks this factory's agents/   -> ~/.config/opencode/agents
#      and                      commands/ -> ~/.config/opencode/commands
#      so OpenCode detects the team globally (see README § "Instalación").
#   2. Copies .env.example -> <project>/.env  (only if .env does NOT exist).
#   3. Copies templates/    -> <project>/templates/  (PRD, etc.).
#   4. Runs `codegraph init` inside the project if the codegraph CLI exists.
#   5. Installs optional plugins (ponytail, caveman, RTK) when requested
#      with --with-plugins (or the per-plugin flags). Skips what is missing.
#   6. Registers graphify (knowledge graph) via `graphify install --project`
#      when requested with --with-graphify. Skips if the CLI is missing.
#
# Claude Code alternative (NOT symlinked into ~/.config):
#   ln -s <factory-root>/.claude  <project>/.claude
#   # .claude/ MUST live INSIDE the project working directory for Claude Code
#   # to detect it. agents/ are referenced by .claude/CLAUDE.md — not duplicated.
#   # Example:  ln -s ~/opencode-agents/.claude ~/mi-proyecto/.claude
#
# Safety: non-destructive. Never overwrites an existing .env. Backs up
# non-symlink targets before replacing. `--dry-run` prints actions only.
# =============================================================================

set -euo pipefail

# --- Locate factory root (parent of bin/) ------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FACTORY_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# --- Config (override via env) -----------------------------------------------
OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
DRY_RUN=0
WITH_PONYTAIL=0
WITH_CAVEMAN=0
WITH_RTK=0
WITH_GRAPHIFY=0

usage() {
  cat <<'EOF'
Usage: factory-init <project-path> [--dry-run] [--with-plugins]
                               [--with-ponytail] [--with-caveman] [--with-rtk]
                               [--with-graphify]

Scaffold <project-path> to use the opencode-agents software factory.

  <project-path>   Target project directory (created if missing).
  --dry-run        Print actions without executing them.
  --with-plugins   Install all optional plugins (ponytail + caveman + RTK).
  --with-ponytail  Install ponytail (OpenCode + Claude Code).
  --with-caveman   Install caveman (OpenCode + Claude Code).
  --with-rtk       Wire RTK for OpenCode and Claude Code.
  --with-graphify  Register graphify skill (knowledge graph).

Examples:
  factory-init ~/code/my-app
  factory-init ~/code/my-app --with-plugins
  factory-init ~/code/my-app --dry-run --with-ponytail
  factory-init ~/code/my-app --with-graphify
EOF
}

log()  { printf '\033[1;32m[factory-init]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[factory-init]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[factory-init]\033[0m %s\n' "$*" >&2; exit 1; }

# --- Args --------------------------------------------------------------------
[[ $# -lt 1 ]] && { usage; exit 1; }
PROJECT=""
for a in "$@"; do
  case "$a" in
    --dry-run) DRY_RUN=1 ;;
    --with-plugins) WITH_PONYTAIL=1; WITH_CAVEMAN=1; WITH_RTK=1 ;;
    --with-ponytail) WITH_PONYTAIL=1 ;;
    --with-caveman) WITH_CAVEMAN=1 ;;
    --with-rtk) WITH_RTK=1 ;;
    --with-graphify) WITH_GRAPHIFY=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) usage; exit 1 ;;
    *) [[ -n "$PROJECT" ]] && { usage; exit 1; }; PROJECT="$a" ;;
  esac
done
[[ -z "$PROJECT" ]] && { usage; exit 1; }

# --- Normalize project path to absolute --------------------------------------
PROJECT="${PROJECT%/}"
[[ "$PROJECT" == "." ]] && PROJECT="$PWD"
if [[ "$PROJECT" != /* ]]; then
  PROJECT="$PWD/$PROJECT"
fi
PARENT="$(dirname "$PROJECT")"
BASE="$(basename "$PROJECT")"
RESOLVED_PARENT="$(cd "$PARENT" 2>/dev/null && pwd)"
PROJECT="${RESOLVED_PARENT:-$PARENT}/$BASE"

# --- Sanity: factory must have the required dirs/files -----------------------
[[ -d "$FACTORY_ROOT/agents"     ]] || err "Missing $FACTORY_ROOT/agents"
[[ -d "$FACTORY_ROOT/commands"   ]] || err "Missing $FACTORY_ROOT/commands"
[[ -d "$FACTORY_ROOT/templates"  ]] || err "Missing $FACTORY_ROOT/templates"
[[ -f "$FACTORY_ROOT/.env.example" ]] || err "Missing $FACTORY_ROOT/.env.example"

# --- Helpers -----------------------------------------------------------------
symlink() { # $1=source(abs) $2=dest(abs)
  local src="$1" dst="$2"
  if [[ -L "$dst" ]]; then
    log "refresh symlink: $dst -> $src"
    if [[ $DRY_RUN -eq 0 ]]; then ln -sfn "$src" "$dst"; fi
  elif [[ -e "$dst" ]]; then
    local bak="${dst}.bak.$(date +%s)"
    warn "backup existing non-symlink: $dst -> $bak"
    if [[ $DRY_RUN -eq 0 ]]; then mv "$dst" "$bak"; fi
    log "create symlink: $dst -> $src"
    if [[ $DRY_RUN -eq 0 ]]; then ln -s "$src" "$dst"; fi
  else
    log "create symlink: $dst -> $src"
    if [[ $DRY_RUN -eq 0 ]]; then ln -s "$src" "$dst"; fi
  fi
}

copy_if_missing() { # $1=src $2=dst
  local src="$1" dst="$2"
  if [[ -e "$dst" ]]; then
    log "skip (exists): $dst"
  else
    log "copy: $src -> $dst"
    if [[ $DRY_RUN -eq 0 ]]; then cp "$src" "$dst"; fi
  fi
}

run_soft() { # optional/network command: log, run, warn on failure (never abort)
  log "run: $*"
  if [[ $DRY_RUN -eq 0 ]]; then
    "$@" || warn "falló: $* (continuando)"
  fi
}

install_caveman_opencode() { # caveman refuses symlinked target dirs; stage in a temp dir, then merge
  local tmp
  tmp="$(mktemp -d)"
  log "run: OPENCODE_CONFIG_DIR=$tmp npx -y github:JuliusBrussee/caveman -- --only opencode"
  log "merge: <tmp>/{plugins/caveman,skills,AGENTS.md} -> $OPENCODE_CONFIG_DIR"
  log "merge: <tmp>/commands/*.md -> $FACTORY_ROOT/commands"
  [[ $DRY_RUN -eq 0 ]] || { return 0; }

  if ! env OPENCODE_CONFIG_DIR="$tmp" npx -y github:JuliusBrussee/caveman -- --only opencode; then
    warn "falló: caveman (OpenCode) — continuando"
    rm -rf "$tmp"
    return 0
  fi

  mkdir -p "$OPENCODE_CONFIG_DIR/plugins/caveman" "$OPENCODE_CONFIG_DIR/skills" "$FACTORY_ROOT/commands"
  cp -R "$tmp/plugins/caveman/." "$OPENCODE_CONFIG_DIR/plugins/caveman/"
  cp -R "$tmp/skills/." "$OPENCODE_CONFIG_DIR/skills/"
  cp "$tmp/AGENTS.md" "$OPENCODE_CONFIG_DIR/AGENTS.md"
  cp "$tmp/.caveman-opencode-ownership.json" "$OPENCODE_CONFIG_DIR/"
  cp "$tmp/commands/"*.md "$FACTORY_ROOT/commands/"
  rm -rf "$tmp"
  # OpenCode auto-loads $OPENCODE_CONFIG_DIR/plugins/* — no opencode.json patch needed.
  log "caveman listo (plugin + skills + AGENTS.md + commands)"
}

# --- Main --------------------------------------------------------------------
log "factory root : $FACTORY_ROOT"
log "project      : $PROJECT"
log "opencode cfg : $OPENCODE_CONFIG_DIR"

# 1. OpenCode global symlinks (agents + commands)
log "== OpenCode symlinks =="
if [[ $DRY_RUN -eq 0 ]]; then mkdir -p "$OPENCODE_CONFIG_DIR"; fi
symlink "$FACTORY_ROOT/agents"   "$OPENCODE_CONFIG_DIR/agents"
symlink "$FACTORY_ROOT/commands" "$OPENCODE_CONFIG_DIR/commands"

# 2. Ensure project dir exists
log "== Project scaffold =="
if [[ $DRY_RUN -eq 0 ]]; then mkdir -p "$PROJECT"; fi

# 3. .env (never overwrite an existing one)
copy_if_missing "$FACTORY_ROOT/.env.example" "$PROJECT/.env"

# 4. templates/ -> project
if [[ -e "$PROJECT/templates" ]]; then
  log "skip (exists): $PROJECT/templates"
else
  log "copy: $FACTORY_ROOT/templates -> $PROJECT/templates"
  if [[ $DRY_RUN -eq 0 ]]; then cp -R "$FACTORY_ROOT/templates" "$PROJECT/templates"; fi
fi

# 5. codegraph init (project) — only if CLI present
log "== CodeGraph index =="
if command -v codegraph >/dev/null 2>&1; then
  log "codegraph detected — indexing project"
  if [[ $DRY_RUN -eq 0 ]]; then (cd "$PROJECT" && codegraph init); fi
else
  warn "codegraph CLI not found — skipping (install: npm i -g @colbymchenry/codegraph)"
fi

# 6. Optional plugins (opt-in: --with-plugins / --with-<plugin>)
if [[ $WITH_PONYTAIL -eq 1 || $WITH_CAVEMAN -eq 1 || $WITH_RTK -eq 1 ]]; then
  log "== Plugins (opcional) =="
fi

if [[ $WITH_PONYTAIL -eq 1 ]]; then
  if command -v opencode >/dev/null 2>&1; then
    run_soft opencode plugin add @dietrichgebert/ponytail
  else
    warn "opencode no encontrado — salto ponytail (OpenCode)"
  fi
  if command -v claude >/dev/null 2>&1; then
    run_soft claude plugin marketplace add DietrichGebert/ponytail
    run_soft claude plugin install ponytail@ponytail
  else
    warn "claude no encontrado — salto ponytail (Claude Code)"
  fi
fi

if [[ $WITH_CAVEMAN -eq 1 ]]; then
  if command -v npx >/dev/null 2>&1; then
    install_caveman_opencode
  else
    warn "npx no encontrado — salto caveman (OpenCode)"
  fi
  if command -v claude >/dev/null 2>&1; then
    run_soft claude plugin marketplace add JuliusBrussee/caveman
    run_soft claude plugin install caveman@caveman
  else
    warn "claude no encontrado — salto caveman (Claude Code)"
  fi
fi

if [[ $WITH_RTK -eq 1 ]]; then
  if command -v rtk >/dev/null 2>&1; then
    run_soft rtk init -g --opencode
    if command -v claude >/dev/null 2>&1; then run_soft rtk init -g; fi
  else
    warn "rtk no encontrado — instalalo con: brew install rtk (o cargo install rtk)"
  fi
fi

if [[ $WITH_GRAPHIFY -eq 1 ]]; then
  log "== Graphify =="
  if command -v graphify >/dev/null 2>&1; then
    log "graphify detected — registering skill in project"
    if [[ $DRY_RUN -eq 0 ]]; then
      (cd "$PROJECT" && graphify install --project) || warn "falló: graphify install --project (continuando)"
    else
      log "run: (cd $PROJECT && graphify install --project)"
    fi
    if [[ -f "$PROJECT/.gitignore" ]]; then
      if grep -q '^graphify-out/' "$PROJECT/.gitignore"; then
        log "skip (already ignored): graphify-out/"
      else
        log "append: $PROJECT/.gitignore -> graphify-out/"
        if [[ $DRY_RUN -eq 0 ]]; then printf '\ngraphify-out/\n' >> "$PROJECT/.gitignore"; fi
      fi
    else
      log "create: $PROJECT/.gitignore -> graphify-out/"
      if [[ $DRY_RUN -eq 0 ]]; then printf 'graphify-out/\n' > "$PROJECT/.gitignore"; fi
    fi
  else
    warn "graphify no encontrado — instalalo con: uv tool install graphifyy"
  fi
fi

# 7. Claude Code alternative (documented, not automated)
log "== Claude Code =="
cat <<EOF
  Claude Code does NOT use ~/.config symlinks. Wire the factory manually:
    ln -s "$FACTORY_ROOT/.claude" "$PROJECT/.claude"
  (.claude/ must live inside the project working directory to be detected.)
EOF

log "done."
