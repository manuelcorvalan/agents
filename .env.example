# =============================================================================
# opencode-agents — Variables de entorno
# =============================================================================
# Copia este archivo como .env y completa los valores.
# Se cargan automáticamente con direnv (recomendado) o manualmente con:
#   set -a && source .env && set +a
# =============================================================================

# DeepSeek
DEEPSEEK_API_KEY=sk-tu-api-key-aqui

# Jira (agente PM) — https://id.atlassian.com/manage/api-tokens
JIRA_EMAIL=tu-email@ejemplo.com
JIRA_API_TOKEN=tu-api-token-de-atlassian
JIRA_BASE_URL=https://tu-espacio.atlassian.net

# Context7 (opcional) — docs actualizadas de librerías
# Sin key funciona; la key sube el rate limit. https://context7.com/dashboard
CONTEXT7_API_KEY=

# Chat bridge (integrations/chat, ADR-0003) — opcional, apagado por defecto
# Vacío = desactivado. Poné exactamente "true" para activar (con direnv, recargá el entorno).
CHAT_BRIDGE_ENABLED=
# Vacío = usa config.json (dry_run: true). "true" = no envía a Slack, solo registra (recomendado al probar).
CHAT_BRIDGE_DRY_RUN=
# Ruta alternativa a config.json (default: integrations/chat/config/config.json)
CHAT_BRIDGE_CONFIG=
# Directorio del spool (default: <proyecto>/.chat-bridge/)
CHAT_BRIDGE_SPOOL_DIR=
# Slack Bot User OAuth Token (xoxb-...) — scopes chat:write + chat:write.customize. Nunca commitear.
SLACK_BOT_TOKEN=
# Canal por defecto (opcional; pisa default_channel de config.json)
CHAT_BRIDGE_CHANNEL_DEFAULT=
# Canal por tipo de evento (opcional; pisan channels.<tipo> de config.json)
CHAT_BRIDGE_CHANNEL_HANDOFF=
CHAT_BRIDGE_CHANNEL_AGENT_STARTED=
CHAT_BRIDGE_CHANNEL_AGENT_FINISHED=
CHAT_BRIDGE_CHANNEL_GATE_RESULT=
